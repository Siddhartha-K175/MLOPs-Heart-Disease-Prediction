# Supabase (Postgres) connection for the heart-disease app.
# Copy this file to .env and paste your connection string:
# Supabase dashboard -> your project -> Connect -> "Session pooler" URI,
# with [YOUR-PASSWORD] replaced by the database password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=heart_health
DB_TEST_SCHEMA=heart_health_test
# Supabase Auth (patient email sign-up). Dashboard -> Project Settings -> API Keys:
# the publishable key is safe to share; never put the secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where confirmation emails send patients back to (add it under Auth -> URL Configuration).
APP_URL=http://localhost:8502
